{% extends "base.html.j2" %}
{# Hook-first story cover. With `photo`, the image is full-bleed, desaturated and faded to black behind the text.
   Without one, it sits on the terminal grid. Used at 1080x1350 (post) and 1080x1920 (story). #}
{% block css %}
.slide.cover{padding:56px 64px}
.photo{position:absolute;inset:0;z-index:0}
.photo img{width:100%;height:100%;object-fit:cover;object-position:{{ slide.photo.position or 'center' }};filter:grayscale(.55) contrast(1.08) brightness(.78)}
.photo::after{content:"";position:absolute;inset:0;background:
  linear-gradient(180deg,rgba(9,11,13,.96) 0%,rgba(9,11,13,.88) {{ 30 if story_canvas else 34 }}%,rgba(9,11,13,.25) {{ 58 if story_canvas else 62 }}%,rgba(9,11,13,.35) 78%,rgba(9,11,13,.95) 100%)}
.mini{display:flex;justify-content:space-between;align-items:center}
.mini .brand{font-size:32px}.mini .brand i{width:18px;height:18px}
.label{display:inline-block;background:var(--accent);color:var(--bg);font-family:'JetBrains Mono';font-weight:700;font-size:22px;letter-spacing:.06em;padding:8px 14px;text-transform:uppercase}
.hook{font-family:'Barlow Condensed';font-weight:700;text-transform:uppercase;line-height:.9;letter-spacing:-.01em;padding-bottom:14px}
.hook .hl{color:var(--accent);text-decoration:underline;text-decoration-thickness:8px;text-underline-offset:10px;text-decoration-skip-ink:none}
.center{text-align:center}.center .stats{justify-content:center}
.stats{display:flex;gap:0;margin-top:40px;border-top:1px solid var(--line2);border-bottom:1px solid var(--line2)}
.stats>div{flex:1;padding:20px 0 18px 24px;border-left:1px solid var(--line2)}
.stats>div:first-child{border-left:none;padding-left:0}
.stats .l{font-size:18px;color:var(--muted)}
.stats .v{font-family:'Barlow Condensed';font-weight:600;font-size:66px;line-height:1.05}
.stats .d{font-size:19px}
.bottom{margin-top:auto;display:flex;justify-content:space-between;align-items:flex-end;gap:32px}
.cta{display:inline-flex;background:var(--accent);color:var(--bg);font-family:'JetBrains Mono';font-weight:700;font-size:24px;letter-spacing:.06em;padding:18px 26px;white-space:nowrap}
.src{font-family:'JetBrains Mono';font-size:15px;color:var(--muted);letter-spacing:.03em;line-height:1.5;text-align:right}
{% endblock %}
{% block body %}
{% if slide.photo %}<div class="photo"><img src="{{ slide.photo._uri }}" alt=""></div>{% else %}<div class="grid"></div>{% endif %}
<div class="mini"><div class="brand"><i></i>ATLAS</div><div class="tag mono"><b>{{ slide.section or story.section }}</b></div></div>
<div class="{{ 'center' if (slide.align or ('center' if slide.photo else 'left')) == 'center' else '' }}" style="margin-top:{{ slide.top or 90 }}px">
  {% if slide.kicker %}<div class="label">{{ slide.kicker }}</div>{% endif %}
  <div class="hook" data-fit="{{ slide.fit or (820 if story_canvas else 600) }}" data-min="70" style="font-size:{{ slide.size or (190 if story_canvas else 168) }}px;margin-top:22px">{{ slide.headline | hl }}</div>
  {% if slide.dek %}<p class="dek" style="margin-top:30px;{{ 'margin-left:auto;margin-right:auto' if slide.photo else '' }}">{{ slide.dek | hl }}</p>{% endif %}
  {% if slide.stats %}<div class="stats">{% for s in slide.stats %}<div><div class="l mono">{{ s.label }}</div><div class="v">{{ s.value }}</div>{% if s.delta %}<div class="d mono {{ 'risk' if s.tone == 'risk' else 'hl' }}">{{ s.delta }}</div>{% endif %}</div>{% endfor %}</div>{% endif %}
  {% if slide._spark %}<div style="margin-top:36px">{{ slide._spark | safe }}</div>{% endif %}
</div>
<div class="bottom"><div class="cta">{{ slide.cta or 'SWIPE' }} →</div>
<div class="src">{{ slide._footnote_short | safe }}{% if slide.photo and slide.photo.credit %}<br>Photo: {{ slide.photo.credit }}{% endif %}</div></div>
{% endblock %}
