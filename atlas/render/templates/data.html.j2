{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{# Data and evidence: one main line chart, optional secondary bar panel. All values come from the spec's series. #}
{% block body %}
{{ m.header(story, slide) }}
<div style="margin-top:52px"><div class="kicker mono">▍ {{ slide.kicker or 'THE DATA' }}</div><h2 data-fit="160" data-min="52">{{ slide.title | hl }}</h2></div>
{% if slide.chart.series|length > 1 %}<div class="legend mono" style="margin-top:34px">{% for s in slide.chart.series|reverse %}<span style="color:{{ 'var(--fg)' if s.emphasis else 'var(--muted)' }}"><i style="background:{{ s._color }};height:{{ 4 if s.emphasis else 3 }}px"></i>{{ s.name|upper }}</span>{% endfor %}</div>{% endif %}
<div style="margin-top:14px">{{ slide._chart | safe }}</div>
{% if slide._bars %}<div class="mono" style="margin-top:22px;font-size:18px;color:var(--muted)">{{ slide.bars.title }}{% if slide.bars.threshold is not none %} &nbsp;<span class="risk">■</span> ≥ {{ slide.bars.threshold_label or slide.bars.threshold }}{% endif %}</div>
<div style="margin-top:6px">{{ slide._bars | safe }}</div>{% endif %}
{% if slide.note %}<p style="margin-top:22px;font-size:24px;line-height:1.45;color:var(--muted)">{{ slide.note | hl }}</p>{% endif %}
{{ m.footer(slide) }}
{% endblock %}
